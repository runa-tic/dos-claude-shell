@ECHO OFF
ECHO first line > P4OUT.TXT
ECHO second line >> P4OUT.TXT
TYPE P4OUT.TXT
ECHO replaced>P4OUT.TXT
TYPE P4OUT.TXT
SET > NUL
DIR /B C:\T\*.COM > P4DIR.TXT
TYPE P4DIR.TXT
C:\T\HELLO redirected > P4OUT.TXT
TYPE P4OUT.TXT
C:\T\UPPER < C:\T\INPUT.TXT
TYPE C:\T\INPUT.TXT | C:\T\UPPER
ECHO three stages | C:\T\UPPER | C:\T\UPPER
DIR /B C:\T\H*.* | C:\T\UPPER > P4OUT.TXT
TYPE P4OUT.TXT
FOR %%F IN (a b) DO ECHO for %%F >> P4OUT.TXT
TYPE P4OUT.TXT
IF EXIST P4OUT.TXT ECHO if redirected > P4OUT.TXT
TYPE P4OUT.TXT
DEL P4OUT.TXT
DEL P4DIR.TXT
DIR /B
ECHO done
